<?xml version="1.0"?>
<robot name="rm65_curobo">
  <!-- RealMan controller base. The vendor model's base_link is rotated by
       -90 deg about Y relative to the physically installed driver base. -->
  <link name="driver_base"/>
  <link name="base_link"/>
  <joint name="driver_base_to_urdf_base" type="fixed">
    <origin xyz="0 0 0" rpy="0 -1.5707963267948966 0"/>
    <parent link="driver_base"/>
    <child link="base_link"/>
  </joint>
  <link name="Link1"/>
  <link name="Link2"/>
  <link name="Link3"/>
  <link name="Link4"/>
  <link name="Link5"/>
  <link name="Link6"/>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.2405" rpy="0 0 0"/><parent link="base_link"/><child link="Link1"/>
    <axis xyz="0 0 1"/><limit lower="-3.1" upper="3.1" effort="60" velocity="3.14"/>
  </joint>
  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="1.5708 -1.5708 0"/><parent link="Link1"/><child link="Link2"/>
    <axis xyz="0 0 1"/><limit lower="-2.268" upper="2.268" effort="60" velocity="3.14"/>
  </joint>
  <joint name="joint3" type="revolute">
    <origin xyz="0.256 0 0" rpy="0 0 1.5708"/><parent link="Link2"/><child link="Link3"/>
    <axis xyz="0 0 1"/><limit lower="-2.355" upper="2.355" effort="30" velocity="3.92"/>
  </joint>
  <joint name="joint4" type="revolute">
    <origin xyz="0 -0.21 0" rpy="1.5708 0 0"/><parent link="Link3"/><child link="Link4"/>
    <axis xyz="0 0 1"/><limit lower="-3.1" upper="3.1" effort="10" velocity="3.92"/>
  </joint>
  <joint name="joint5" type="revolute">
    <origin xyz="0 0 0" rpy="-1.5708 0 0"/><parent link="Link4"/><child link="Link5"/>
    <axis xyz="0 0 1"/><limit lower="-2.233" upper="2.233" effort="10" velocity="3.92"/>
  </joint>
  <joint name="joint6" type="revolute">
    <origin xyz="0 -0.144 0" rpy="1.5708 0 0"/><parent link="Link5"/><child link="Link6"/>
    <axis xyz="0 0 1"/><limit lower="-6.28" upper="6.28" effort="10" velocity="3.92"/>
  </joint>
</robot>
