<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>chassis_ros</name>
  <version>1.0.0</version>
  <description>Woosh Robot Chassis ROS2 Interface Package</description>
  <maintainer email="user@example.com">lh</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>lh_chassis_interfaces</depend>

  <!-- 官方消息包 -->
  <depend>woosh_robot_msgs</depend>
  <depend>woosh_ros_msgs</depend>
  <depend>woosh_task_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
