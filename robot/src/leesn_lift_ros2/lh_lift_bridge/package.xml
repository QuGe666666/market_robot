<?xml version="1.0"?>
<package format="3">
  <name>lh_lift_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 Humble HTTP bridge for the lift service.</description>
  <maintainer email="devnull@example.com">Codex</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>ament_index_python</depend>
  <depend>lh_lift_interfaces</depend>
  <depend>rclpy</depend>
  <depend>std_srvs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-requests</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
